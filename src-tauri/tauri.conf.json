{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konstruct",
  "version": "0.1.0",
  "identifier": "cc.konstruct.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Konstruct",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "backgroundColor": "#062038"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "SocialNetworking",
    "license": "MPL-2.0",
    "shortDescription": "Konstruct messenger",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
